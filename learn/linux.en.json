  {
   "id": "c3",
   "title": "Permissions and admin",
   "minutes": 12,
   "badge": {
    "name": "Permissions keeper",
    "emoji": "🔐"
   },
   "lesson": [
    {
     "h": "Reading permissions",
     "p": "ls -l shows permissions like -rwxr-xr--. r = read, w = write, x = execute, for the owner, then the group, then others.",
     "code": "ls -l script.sh",
     "out": "-rwxr-xr-- 1 jikel dev 120 script.sh"
    },
    {
     "h": "chmod",
     "p": "chmod changes permissions. chmod +x script.sh makes a script executable. If you see “Permission denied”, it is often a permissions problem."
    },
    {
     "h": "sudo",
     "p": "sudo runs a command as administrator. Powerful, so dangerous: only use it if you understand the command."
    },
    {
     "h": "Services and disk space",
     "p": "df -h shows disk space. systemctl status name shows whether a service runs, and systemctl restart name restarts it. A full disk is a frequent cause of server failure."
    }
   ],
   "exercises": [
    {
     "id": "e1",
     "type": "choice",
     "q": "What does the letter x mean in permissions?",
     "options": [
      "Execute",
      "Write",
