   "lesson": [
    {
     "h": "Create",
     "p": "mkdir creates a folder, touch creates an empty file.",
     "code": "mkdir projet\ntouch projet/notes.txt"
    },
    {
     "h": "Copy, move, rename",
     "p": "cp copies, mv moves or renames.",
     "code": "cp notes.txt copie.txt\nmv copie.txt archive/"
    },
    {
     "h": "Read",
     "p": "cat shows a whole file, head the first lines, tail the last ones. Very handy for error logs."
    },
    {
     "h": "Deleting: careful",
     "p": "rm deletes with no recycle bin: no way back. rm -r deletes a whole folder. Never type rm -rf /: you destroy the whole system."
    }
   ],
