   "lesson": [
    {
     "h": "Why the terminal?",
     "p": "Linux runs most of the Internet's servers. The terminal lets you talk to it with commands, fast and without a mouse."
    },
    {
     "h": "Where am I?",
     "p": "pwd shows the current folder. ls lists its contents. cd changes folder.",
     "code": "pwd\nls\ncd Documents\ncd ..",
     "out": "/home/jikel\nDocuments  Images  notes.txt"
    },
    {
     "h": "Paths",
     "p": "An absolute path starts with / (e.g. /home/jikel). A relative path starts from the current folder. “..” means the parent folder, “~” your home folder."
    },
    {
     "h": "Asking for help",
     "p": "man ls opens the command's manual, and most commands accept --help. Case matters: Documents and documents are different."
    }
   ],
   "exercises": [
